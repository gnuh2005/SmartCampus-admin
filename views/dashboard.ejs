<%- include('partials/head', { title: 'Tổng quan' }) %>
<body>
  <%- include('partials/sidebar', { active: 'dashboard' }) %>
  <div class="main-wrap">
    <%- include('partials/navbar', { title: 'Tổng quan', subtitle: 'Theo dõi hoạt động Smart Campus theo thời gian thực' }) %>

    <main class="py-5 space-y-4">
      <!-- Bento Grid -->
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4">

        <!-- KPI: Sinh viên -->
        <article class="glass hover-lift rounded-3xl p-5 lg:col-span-3 fade-up" style="animation-delay:.02s">
          <div class="flex items-start justify-between">
            <span class="h-11 w-11 rounded-2xl grid place-items-center text-white" style="background:linear-gradient(135deg,#6366f1,#8b5cf6)"><i data-lucide="users" class="h-5 w-5"></i></span>
            <span data-kpi-badge="students" class="shimmer h-6 w-14 rounded-full"></span>
          </div>
          <p class="mt-4 text-sm font-semibold t-muted">Tổng sinh viên</p>
          <p class="mt-1 text-3xl font-extrabold t-main"><span data-kpi="students" class="shimmer inline-block h-9 w-24 align-middle"></span></p>
          <p class="mt-1 text-xs t-muted" data-kpi-sub="students">&nbsp;</p>
        </article>

        <!-- KPI: Lớp học -->
        <article class="glass hover-lift rounded-3xl p-5 lg:col-span-3 fade-up" style="animation-delay:.07s">
          <div class="flex items-start justify-between">
            <span class="h-11 w-11 rounded-2xl grid place-items-center text-white" style="background:linear-gradient(135deg,#06b6d4,#3b82f6)"><i data-lucide="book-open" class="h-5 w-5"></i></span>
            <span data-kpi-badge="schedules" class="shimmer h-6 w-14 rounded-full"></span>
          </div>
          <p class="mt-4 text-sm font-semibold t-muted">Lớp học đang mở</p>
          <p class="mt-1 text-3xl font-extrabold t-main"><span data-kpi="schedules" class="shimmer inline-block h-9 w-24 align-middle"></span></p>
          <p class="mt-1 text-xs t-muted">Buổi học trong thời khóa biểu</p>
        </article>

        <!-- KPI: Bảng tin -->
        <article class="glass hover-lift rounded-3xl p-5 lg:col-span-3 fade-up" style="animation-delay:.12s">
          <div class="flex items-start justify-between">
            <span class="h-11 w-11 rounded-2xl grid place-items-center text-white" style="background:linear-gradient(135deg,#f59e0b,#f43f5e)"><i data-lucide="megaphone" class="h-5 w-5"></i></span>
            <span data-kpi-badge="announcements" class="shimmer h-6 w-14 rounded-full"></span>
          </div>
          <p class="mt-4 text-sm font-semibold t-muted">Bài viết bảng tin</p>
          <p class="mt-1 text-3xl font-extrabold t-main"><span data-kpi="announcements" class="shimmer inline-block h-9 w-24 align-middle"></span></p>
          <p class="mt-1 text-xs t-muted">Bao gồm cả bài nháp</p>
        </article>

        <!-- KPI: Tài khoản bị khóa -->
        <article class="glass hover-lift rounded-3xl p-5 lg:col-span-3 fade-up" style="animation-delay:.17s">
          <div class="flex items-start justify-between">
            <span class="h-11 w-11 rounded-2xl grid place-items-center text-white" style="background:linear-gradient(135deg,#f43f5e,#be123c)"><i data-lucide="user-x" class="h-5 w-5"></i></span>
            <a href="/users" class="text-xs font-bold text-brand-500 hover:underline">Quản lý →</a>
          </div>
          <p class="mt-4 text-sm font-semibold t-muted">Tài khoản bị khóa</p>
          <p class="mt-1 text-3xl font-extrabold t-main"><span data-kpi="blocked" class="shimmer inline-block h-9 w-24 align-middle"></span></p>
          <p class="mt-1 text-xs t-muted" data-kpi-sub="blocked">&nbsp;</p>
        </article>

        <!-- Biểu đồ đăng nhập -->
        <article class="glass rounded-3xl p-5 lg:col-span-8 sm:col-span-2 fade-up" style="animation-delay:.22s">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h2 class="font-extrabold t-main">Lượt đăng nhập theo ngày</h2>
              <p class="text-xs t-muted">7 ngày gần nhất</p>
            </div>
            <span class="badge cat-general"><i data-lucide="trending-up" class="h-3.5 w-3.5"></i> Truy cập</span>
          </div>
          <div class="relative h-64">
            <div id="sk-line" class="shimmer absolute inset-0 rounded-2xl"></div>
            <canvas id="chart-line" class="hidden"></canvas>
          </div>
        </article>

        <!-- Biểu đồ khoa -->
        <article class="glass rounded-3xl p-5 lg:col-span-4 sm:col-span-2 fade-up" style="animation-delay:.27s">
          <div class="mb-4">
            <h2 class="font-extrabold t-main">Sinh viên theo khoa</h2>
            <p class="text-xs t-muted">Phân bố sinh viên</p>
          </div>
          <div class="relative h-64">
            <div id="sk-donut" class="shimmer absolute inset-0 rounded-2xl"></div>
            <canvas id="chart-donut" class="hidden"></canvas>
          </div>
        </article>

        <!-- Biểu đồ lịch học -->
        <article class="glass rounded-3xl p-5 lg:col-span-5 sm:col-span-2 fade-up" style="animation-delay:.32s">
          <div class="mb-4">
            <h2 class="font-extrabold t-main">Số buổi học theo thứ</h2>
            <p class="text-xs t-muted">Phân bố thời khóa biểu trong tuần</p>
          </div>
          <div class="relative h-64">
            <div id="sk-bar" class="shimmer absolute inset-0 rounded-2xl"></div>
            <canvas id="chart-bar" class="hidden"></canvas>
          </div>
        </article>

        <!-- Hoạt động gần đây -->
        <article class="glass rounded-3xl p-5 lg:col-span-7 sm:col-span-2 fade-up" style="animation-delay:.37s">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h2 class="font-extrabold t-main">Hoạt động gần đây</h2>
              <p class="text-xs t-muted">8 thao tác mới nhất trên hệ thống</p>
            </div>
            <button type="button" id="refresh-btn" class="icon-btn bordered" title="Làm mới"><i data-lucide="refresh-cw" class="h-4 w-4"></i></button>
          </div>
          <ul id="activity-list" class="space-y-1">
            <% for (let i = 0; i < 5; i++) { %>
              <li class="flex items-center gap-3 p-2.5"><span class="shimmer h-10 w-10 rounded-xl"></span><span class="flex-1 space-y-2"><span class="shimmer block h-3.5 w-3/4"></span><span class="shimmer block h-3 w-1/3"></span></span></li>
            <% } %>
          </ul>
        </article>
      </section>
    </main>

    <%- include('partials/footer') %>
  </div>

  <script>
    (function () {
      var charts = [];
      var lastData = null;
      var PALETTE = ['#6366f1', '#06b6d4', '#10b981', '#f59e0b', '#f43f5e', '#8b5cf6'];
      var TYPE_META = {
        login: { icon: 'log-in', grad: 'linear-gradient(135deg,#06b6d4,#3b82f6)' },
        user: { icon: 'user-cog', grad: 'linear-gradient(135deg,#6366f1,#8b5cf6)' },
        schedule: { icon: 'calendar-plus', grad: 'linear-gradient(135deg,#10b981,#06b6d4)' },
        announcement: { icon: 'megaphone', grad: 'linear-gradient(135deg,#f59e0b,#f43f5e)' },
        system: { icon: 'shield-check', grad: 'linear-gradient(135deg,#64748b,#334155)' }
      };

      function badge(pct) {
        var up = pct >= 0;
        return '<span class="badge ' + (up ? 'badge-active' : 'badge-blocked') + '"><i data-lucide="' + (up ? 'trending-up' : 'trending-down') + '" class="h-3 w-3"></i>' + (up ? '+' : '') + pct + '%</span>';
      }

      function setKpi(name, value) {
        var el = document.querySelector('[data-kpi="' + name + '"]');
        if (!el) return;
        el.classList.remove('shimmer', 'inline-block', 'h-9', 'w-24', 'align-middle');
        SC.countUp(el, value);
      }

      function renderKpis(k) {
        setKpi('students', k.totalStudents);
        setKpi('schedules', k.totalSchedules);
        setKpi('announcements', k.totalAnnouncements);
        setKpi('blocked', k.blockedStudents);
        [['students', k.growth.students], ['schedules', k.growth.schedules], ['announcements', k.growth.announcements]].forEach(function (p) {
          var el = document.querySelector('[data-kpi-badge="' + p[0] + '"]');
          el.outerHTML = badge(p[1]);
        });
        document.querySelector('[data-kpi-sub="students"]').textContent = k.activeStudents.toLocaleString('vi-VN') + ' đang hoạt động · so với 30 ngày trước';
        var pct = k.totalStudents ? Math.round((k.blockedStudents / k.totalStudents) * 100) : 0;
        document.querySelector('[data-kpi-sub="blocked"]').textContent = pct + '% tổng số sinh viên';
      }

      function renderActivities(list) {
        var ul = document.getElementById('activity-list');
        if (!list.length) {
          ul.innerHTML = '<li class="text-center text-sm t-muted py-10">Chưa có hoạt động nào</li>';
          return;
        }
        ul.innerHTML = list.map(function (a) {
          var m = TYPE_META[a.type] || TYPE_META.system;
          return '<li class="flex items-center gap-3 p-2.5 rounded-2xl transition hover:bg-[var(--row-hover)]">' +
            '<span class="h-10 w-10 rounded-xl grid place-items-center text-white shrink-0" style="background:' + m.grad + '"><i data-lucide="' + m.icon + '" class="h-[1.05rem] w-[1.05rem]"></i></span>' +
            '<span class="min-w-0 flex-1"><span class="block text-sm font-semibold t-main truncate">' + SC.esc(a.message) + '</span>' +
            '<span class="block text-xs t-muted">' + SC.esc(a.actorName) + ' · ' + SC.esc(SC.timeAgo(a.createdAt)) + '</span></span></li>';
        }).join('');
      }

      function reveal(skId, canvasId) {
        var sk = document.getElementById(skId);
        if (sk) sk.remove();
        document.getElementById(canvasId).classList.remove('hidden');
      }

      function buildCharts(d) {
        charts.forEach(function (c) { c.destroy(); });
        charts = [];
        var t = SC.chartTheme();
        Chart.defaults.font.family = '"Plus Jakarta Sans", system-ui, sans-serif';
        Chart.defaults.color = t.text;

        var tooltip = { backgroundColor: t.tooltipBg, titleColor: '#fff', bodyColor: '#e2e8f0', padding: 10, cornerRadius: 10, displayColors: false };

        // Line: lượt đăng nhập
        var lineCtx = document.getElementById('chart-line').getContext('2d');
        var grad = lineCtx.createLinearGradient(0, 0, 0, 260);
        grad.addColorStop(0, 'rgba(99,102,241,0.35)');
        grad.addColorStop(1, 'rgba(99,102,241,0)');
        charts.push(new Chart(lineCtx, {
          type: 'line',
          data: {
            labels: d.logins.map(function (x) { return x.label; }),
            datasets: [{
              label: 'Lượt đăng nhập', data: d.logins.map(function (x) { return x.count; }),
              borderColor: '#6366f1', backgroundColor: grad, fill: true, tension: 0.4, borderWidth: 3,
              pointRadius: 4, pointHoverRadius: 7, pointBackgroundColor: t.surface, pointBorderColor: '#6366f1', pointBorderWidth: 2
            }]
          },
          options: {
            responsive: true, maintainAspectRatio: false, interaction: { intersect: false, mode: 'index' },
            plugins: { legend: { display: false }, tooltip: tooltip },
            scales: {
              x: { grid: { display: false }, border: { display: false } },
              y: { beginAtZero: true, grid: { color: t.grid }, border: { display: false }, ticks: { precision: 0 } }
            }
          }
        }));

        // Doughnut: sinh viên theo khoa
        charts.push(new Chart(document.getElementById('chart-donut'), {
          type: 'doughnut',
          data: {
            labels: d.faculties.map(function (x) { return x.label; }),
            datasets: [{ data: d.faculties.map(function (x) { return x.count; }), backgroundColor: PALETTE, borderColor: t.surface, borderWidth: 3, hoverOffset: 8 }]
          },
          options: {
            responsive: true, maintainAspectRatio: false, cutout: '66%',
            plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, boxHeight: 10, usePointStyle: true, padding: 12, font: { size: 11 } } }, tooltip: tooltip }
          }
        }));

        // Bar: lịch học theo thứ
        charts.push(new Chart(document.getElementById('chart-bar'), {
          type: 'bar',
          data: {
            labels: d.schedulesByDay.map(function (x) { return x.label; }),
            datasets: [{ label: 'Số buổi học', data: d.schedulesByDay.map(function (x) { return x.count; }), backgroundColor: '#06b6d4', hoverBackgroundColor: '#6366f1', borderRadius: 10, borderSkipped: false, maxBarThickness: 36 }]
          },
          options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false }, tooltip: tooltip },
            scales: {
              x: { grid: { display: false }, border: { display: false } },
              y: { beginAtZero: true, grid: { color: t.grid }, border: { display: false }, ticks: { precision: 0 } }
            }
          }
        }));

        reveal('sk-line', 'chart-line');
        reveal('sk-donut', 'chart-donut');
        reveal('sk-bar', 'chart-bar');
      }

      function load() {
        return SC.api('/api/dashboard/stats').then(function (d) {
          lastData = d;
          renderKpis(d.kpis);
          renderActivities(d.recent);
          buildCharts(d);
          SC.icons();
        }).catch(function (err) { SC.toast('error', err.message); });
      }

      document.getElementById('refresh-btn').addEventListener('click', function () {
        load().then(function () { SC.toast('success', 'Đã làm mới dữ liệu'); });
      });
      document.addEventListener('themechange', function () { if (lastData) buildCharts(lastData); });
      load();
    })();
  </script>
</body>
</html>
