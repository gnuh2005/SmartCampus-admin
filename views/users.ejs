<%- include('partials/head', { title: 'Quản lý sinh viên' }) %>
<body>
  <%- include('partials/sidebar', { active: 'users' }) %>
  <div class="main-wrap">
    <%- include('partials/navbar', { title: 'Quản lý sinh viên', subtitle: 'Tìm kiếm, khóa / mở khóa tài khoản và đặt lại mật khẩu' }) %>

    <main class="py-5 space-y-4">
      <!-- Thống kê nhanh + nút thêm -->
      <section class="flex flex-wrap items-center gap-3 fade-up">
        <span class="badge badge-active"><span class="dot"></span><span id="count-active">—</span> đang hoạt động</span>
        <span class="badge badge-blocked"><span class="dot"></span><span id="count-blocked">—</span> bị khóa</span>
        <button type="button" id="open-create" class="btn btn-primary ml-auto"><i data-lucide="user-plus" class="h-4 w-4"></i> Thêm sinh viên</button>
      </section>

      <!-- Bộ lọc -->
      <section class="glass rounded-3xl p-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-12 fade-up" style="animation-delay:.05s">
        <div class="relative lg:col-span-5 sm:col-span-2">
          <i data-lucide="search" class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 t-muted"></i>
          <input id="f-search" type="search" class="input" style="padding-left:2.4rem" placeholder="Tìm theo tên, email hoặc mã sinh viên..." autocomplete="off" />
        </div>
        <select id="f-faculty" class="input lg:col-span-3"><option value="">Tất cả khoa</option></select>
        <select id="f-class" class="input lg:col-span-2"><option value="">Tất cả lớp</option></select>
        <select id="f-status" class="input lg:col-span-2">
          <option value="">Mọi trạng thái</option>
          <option value="active">Hoạt động</option>
          <option value="blocked">Bị khóa</option>
        </select>
      </section>

      <!-- Bảng -->
      <section class="glass rounded-3xl overflow-hidden fade-up" style="animation-delay:.1s">
        <div class="overflow-x-auto">
          <table class="tbl min-w-[860px]">
            <thead>
              <tr>
                <th>Sinh viên</th><th>Mã SV</th><th>Lớp / Khoa</th><th>Đăng nhập gần nhất</th><th>Trạng thái</th><th>Tài khoản</th><th class="text-right">Thao tác</th>
              </tr>
            </thead>
            <tbody id="tbody"></tbody>
          </table>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3 border-t divider">
          <p id="page-info" class="text-xs font-semibold t-muted"></p>
          <div id="pager" class="flex items-center gap-1"></div>
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>
  </div>

  <!-- Modal thêm sinh viên -->
  <div id="modal-create" class="modal" role="dialog" aria-modal="true" aria-labelledby="mc-title">
    <div class="modal-backdrop" data-close-modal></div>
    <form id="form-create" class="modal-panel p-6" novalidate>
      <div class="flex items-center justify-between mb-5">
        <h3 id="mc-title" class="text-lg font-extrabold t-main">Thêm sinh viên mới</h3>
        <button type="button" class="icon-btn" data-close-modal aria-label="Đóng"><i data-lucide="x" class="h-4 w-4"></i></button>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2"><label class="label" for="c-name">Họ và tên *</label><input id="c-name" class="input" placeholder="Nguyễn Văn A" /></div>
        <div><label class="label" for="c-email">Email *</label><input id="c-email" type="email" class="input" placeholder="sv@student.edu.vn" /></div>
        <div><label class="label" for="c-sid">Mã sinh viên</label><input id="c-sid" class="input" placeholder="22123456" /></div>
        <div><label class="label" for="c-faculty">Khoa</label><input id="c-faculty" class="input" list="dl-faculty" placeholder="Công nghệ thông tin" /></div>
        <div><label class="label" for="c-class">Lớp</label><input id="c-class" class="input" list="dl-class" placeholder="K22-CNTT1" /></div>
        <div class="sm:col-span-2"><label class="label" for="c-phone">Số điện thoại</label><input id="c-phone" class="input" placeholder="09xxxxxxxx" /></div>
        <div class="sm:col-span-2">
          <label class="label" for="c-pw">Mật khẩu *</label>
          <div class="flex gap-2">
            <input id="c-pw" type="text" class="input" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
            <button type="button" id="c-gen" class="btn btn-ghost shrink-0" title="Tạo mật khẩu ngẫu nhiên"><i data-lucide="sparkles" class="h-4 w-4"></i> Tạo</button>
          </div>
        </div>
      </div>
      <datalist id="dl-faculty"></datalist><datalist id="dl-class"></datalist>
      <p id="c-err" class="field-err mt-3"></p>
      <div class="flex justify-end gap-2 mt-3">
        <button type="button" class="btn btn-ghost" data-close-modal>Hủy</button>
        <button type="submit" id="c-submit" class="btn btn-primary"><i data-lucide="check" class="h-4 w-4"></i> Thêm sinh viên</button>
      </div>
    </form>
  </div>

  <!-- Modal đặt lại mật khẩu -->
  <div id="modal-reset" class="modal" role="dialog" aria-modal="true" aria-labelledby="mr-title">
    <div class="modal-backdrop" data-close-modal></div>
    <form id="form-reset" class="modal-panel p-6 !max-w-md" novalidate>
      <div class="flex items-center justify-between mb-4">
        <h3 id="mr-title" class="text-lg font-extrabold t-main">Đặt lại mật khẩu</h3>
        <button type="button" class="icon-btn" data-close-modal aria-label="Đóng"><i data-lucide="x" class="h-4 w-4"></i></button>
      </div>
      <p class="text-sm t-muted mb-4">Đặt mật khẩu mới cho <b id="r-name" class="t-main"></b>.</p>
      <input type="hidden" id="r-id" />
      <label class="label" for="r-pw">Mật khẩu mới *</label>
      <div class="flex gap-2">
        <input id="r-pw" type="text" class="input" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
        <button type="button" id="r-gen" class="btn btn-ghost shrink-0"><i data-lucide="sparkles" class="h-4 w-4"></i> Tạo</button>
      </div>
      <p id="r-err" class="field-err mt-2"></p>
      <div class="flex justify-end gap-2 mt-3">
        <button type="button" class="btn btn-ghost" data-close-modal>Hủy</button>
        <button type="submit" id="r-submit" class="btn btn-primary"><i data-lucide="key-round" class="h-4 w-4"></i> Cập nhật</button>
      </div>
    </form>
  </div>

  <script>
    (function () {
      var state = { page: 1, limit: 10, search: '', faculty: '', className: '', status: '' };
      var tbody = document.getElementById('tbody');
      var EMAIL_RE = /^\S+@\S+\.\S+$/;
      var firstLoad = true;

      function badgeHtml(status) {
        return status === 'blocked'
          ? '<span data-badge class="badge badge-blocked"><span class="dot"></span>Bị khóa</span>'
          : '<span data-badge class="badge badge-active"><span class="dot"></span>Hoạt động</span>';
      }

      function skeleton() {
        var rows = '';
        for (var i = 0; i < 6; i++) {
          rows += '<tr><td><div class="flex items-center gap-3"><span class="shimmer h-10 w-10 rounded-full"></span><span class="space-y-2"><span class="shimmer block h-3.5 w-32"></span><span class="shimmer block h-3 w-44"></span></span></div></td>' +
            '<td><span class="shimmer block h-3.5 w-20"></span></td><td><span class="shimmer block h-3.5 w-28"></span></td><td><span class="shimmer block h-3.5 w-24"></span></td>' +
            '<td><span class="shimmer block h-6 w-24 rounded-full"></span></td><td><span class="shimmer block h-6 w-12 rounded-full"></span></td><td><span class="shimmer block h-6 w-16 ml-auto"></span></td></tr>';
        }
        tbody.innerHTML = rows;
      }

      function fillSelect(sel, values, placeholder) {
        var cur = sel.value;
        sel.innerHTML = '<option value="">' + placeholder + '</option>' + values.map(function (v) {
          return '<option value="' + SC.esc(v) + '">' + SC.esc(v) + '</option>';
        }).join('');
        sel.value = values.indexOf(cur) !== -1 ? cur : '';
      }

      function renderRows(users) {
        if (!users.length) {
          tbody.innerHTML = '<tr><td colspan="7"><div class="py-14 text-center"><i data-lucide="user-search" class="h-10 w-10 mx-auto t-muted"></i><p class="mt-3 font-bold t-main">Không tìm thấy sinh viên</p><p class="text-sm t-muted">Thử thay đổi từ khóa hoặc bộ lọc.</p></div></td></tr>';
          return;
        }
        tbody.innerHTML = users.map(function (u) {
          var active = u.status !== 'blocked';
          return '<tr data-id="' + u._id + '">' +
            '<td><div class="flex items-center gap-3 min-w-0">' + SC.avatar(u.name) +
              '<div class="min-w-0"><p class="font-bold t-main truncate">' + SC.esc(u.name) + '</p><p class="text-xs t-muted truncate">' + SC.esc(u.email) + '</p></div></div></td>' +
            '<td class="font-semibold t-main">' + SC.esc(u.studentId || '—') + '</td>' +
            '<td><p class="font-semibold t-main">' + SC.esc(u.className || '—') + '</p><p class="text-xs t-muted">' + SC.esc(u.faculty || '') + '</p></td>' +
            '<td class="t-muted text-xs font-semibold">' + SC.esc(SC.timeAgo(u.lastLogin)) + '</td>' +
            '<td>' + badgeHtml(u.status) + '</td>' +
            '<td><label class="switch" title="' + (active ? 'Nhấn để khóa tài khoản' : 'Nhấn để mở khóa') + '"><input type="checkbox" data-toggle="' + u._id + '" data-name="' + SC.esc(u.name) + '" ' + (active ? 'checked' : '') + ' aria-label="Bật / tắt tài khoản ' + SC.esc(u.name) + '"><span class="slider"></span></label></td>' +
            '<td><div class="flex justify-end gap-1">' +
              '<button type="button" class="icon-btn" data-reset="' + u._id + '" data-name="' + SC.esc(u.name) + '" title="Đặt lại mật khẩu"><i data-lucide="key-round" class="h-4 w-4"></i></button>' +
              '<button type="button" class="icon-btn danger" data-delete="' + u._id + '" data-name="' + SC.esc(u.name) + '" title="Xóa sinh viên"><i data-lucide="trash-2" class="h-4 w-4"></i></button>' +
            '</div></td></tr>';
        }).join('');
      }

      function renderPager(d) {
        var from = d.total ? (d.page - 1) * d.limit + 1 : 0;
        var to = Math.min(d.page * d.limit, d.total);
        document.getElementById('page-info').textContent = 'Hiển thị ' + from + '–' + to + ' / ' + d.total + ' sinh viên';
        var pager = document.getElementById('pager');
        if (d.pages <= 1) { pager.innerHTML = ''; return; }
        var start = Math.max(1, Math.min(d.page - 2, d.pages - 4));
        var end = Math.min(d.pages, start + 4);
        var html = '<button class="icon-btn bordered" data-page="' + (d.page - 1) + '" ' + (d.page === 1 ? 'disabled style="opacity:.4;pointer-events:none"' : '') + ' aria-label="Trang trước"><i data-lucide="chevron-left" class="h-4 w-4"></i></button>';
        for (var p = start; p <= end; p++) {
          html += '<button class="icon-btn ' + (p === d.page ? 'btn-primary !text-white' : 'bordered') + ' text-sm font-bold" data-page="' + p + '">' + p + '</button>';
        }
        html += '<button class="icon-btn bordered" data-page="' + (d.page + 1) + '" ' + (d.page === d.pages ? 'disabled style="opacity:.4;pointer-events:none"' : '') + ' aria-label="Trang sau"><i data-lucide="chevron-right" class="h-4 w-4"></i></button>';
        pager.innerHTML = html;
      }

      var reqId = 0;
      function load(opts) {
        var my = ++reqId;
        if (firstLoad) skeleton(); else tbody.style.opacity = '.55';
        var qs = new URLSearchParams({ page: state.page, limit: state.limit, search: state.search, faculty: state.faculty, className: state.className, status: state.status });
        return SC.api('/api/users?' + qs.toString()).then(function (d) {
          if (my !== reqId) return; // bỏ kết quả của request cũ
          firstLoad = false;
          state.page = d.page;
          tbody.style.opacity = '';
          renderRows(d.users);
          renderPager(d);
          fillSelect(document.getElementById('f-faculty'), d.filters.faculties, 'Tất cả khoa');
          fillSelect(document.getElementById('f-class'), d.filters.classes, 'Tất cả lớp');
          document.getElementById('dl-faculty').innerHTML = d.filters.faculties.map(function (v) { return '<option value="' + SC.esc(v) + '">'; }).join('');
          document.getElementById('dl-class').innerHTML = d.filters.classes.map(function (v) { return '<option value="' + SC.esc(v) + '">'; }).join('');
          document.getElementById('count-active').textContent = d.counts.active;
          document.getElementById('count-blocked').textContent = d.counts.blocked;
          SC.icons();
        }).catch(function (err) {
          tbody.style.opacity = '';
          SC.toast('error', err.message);
        });
      }

      // ----- Bộ lọc & tìm kiếm trực tiếp -----
      document.getElementById('f-search').addEventListener('input', SC.debounce(function (e) { state.search = e.target.value.trim(); state.page = 1; load(); }, 300));
      [['f-faculty', 'faculty'], ['f-class', 'className'], ['f-status', 'status']].forEach(function (p) {
        document.getElementById(p[0]).addEventListener('change', function (e) { state[p[1]] = e.target.value; state.page = 1; load(); });
      });
      document.getElementById('pager').addEventListener('click', function (e) {
        var b = e.target.closest('[data-page]');
        if (!b) return;
        state.page = parseInt(b.dataset.page, 10);
        load();
      });

      // ----- Công tắc khóa / mở khóa (AJAX, không reload) -----
      tbody.addEventListener('change', function (e) {
        var cb = e.target.closest('[data-toggle]');
        if (!cb) return;
        var want = cb.checked;
        cb.disabled = true;
        SC.api('/api/users/' + cb.dataset.toggle + '/toggle-status', { method: 'PATCH', body: { status: want ? 'active' : 'blocked' } })
          .then(function (res) {
            var u = res.user;
            var row = cb.closest('tr');
            row.querySelector('[data-badge]').outerHTML = badgeHtml(u.status);
            cb.closest('.switch').title = u.status === 'active' ? 'Nhấn để khóa tài khoản' : 'Nhấn để mở khóa';
            var a = document.getElementById('count-active'), b = document.getElementById('count-blocked');
            a.textContent = Math.max(0, parseInt(a.textContent, 10) + (u.status === 'active' ? 1 : -1));
            b.textContent = Math.max(0, parseInt(b.textContent, 10) + (u.status === 'active' ? -1 : 1));
            SC.toast(u.status === 'blocked' ? 'warning' : 'success', (u.status === 'blocked' ? 'Đã khóa tài khoản ' : 'Đã mở khóa tài khoản ') + u.name);
          })
          .catch(function (err) { cb.checked = !want; SC.toast('error', err.message); })
          .finally(function () { cb.disabled = false; });
      });

      // ----- Xóa / đặt lại mật khẩu -----
      tbody.addEventListener('click', function (e) {
        var del = e.target.closest('[data-delete]');
        var rs = e.target.closest('[data-reset]');
        if (del) {
          SC.confirm({ title: 'Xóa sinh viên?', text: 'Tài khoản "' + del.dataset.name + '" sẽ bị xóa vĩnh viễn và không thể khôi phục.', confirmText: 'Xóa', danger: true }).then(function (ok) {
            if (!ok) return;
            SC.api('/api/users/' + del.dataset.delete, { method: 'DELETE' })
              .then(function () { SC.toast('success', 'Đã xóa sinh viên ' + del.dataset.name); load(); })
              .catch(function (err) { SC.toast('error', err.message); });
          });
        } else if (rs) {
          document.getElementById('r-id').value = rs.dataset.reset;
          document.getElementById('r-name').textContent = rs.dataset.name;
          document.getElementById('r-pw').value = '';
          document.getElementById('r-err').textContent = '';
          SC.openModal('modal-reset');
        }
      });

      document.getElementById('r-gen').addEventListener('click', function () { document.getElementById('r-pw').value = SC.genPassword(10); });
      document.getElementById('form-reset').addEventListener('submit', function (e) {
        e.preventDefault();
        var pw = document.getElementById('r-pw').value;
        var err = document.getElementById('r-err');
        if (pw.length < 6) { err.textContent = 'Mật khẩu tối thiểu 6 ký tự'; return; }
        err.textContent = '';
        var btn = document.getElementById('r-submit');
        btn.disabled = true;
        SC.api('/api/users/' + document.getElementById('r-id').value + '/reset-password', { method: 'PATCH', body: { password: pw } })
          .then(function () { SC.closeModal('modal-reset'); SC.toast('success', 'Đã đặt lại mật khẩu'); })
          .catch(function (er) { err.textContent = er.message; })
          .finally(function () { btn.disabled = false; });
      });

      // ----- Thêm sinh viên -----
      document.getElementById('open-create').addEventListener('click', function () {
        document.getElementById('form-create').reset();
        document.getElementById('c-err').textContent = '';
        SC.openModal('modal-create');
      });
      document.getElementById('c-gen').addEventListener('click', function () { document.getElementById('c-pw').value = SC.genPassword(10); });
      document.getElementById('form-create').addEventListener('submit', function (e) {
        e.preventDefault();
        var v = function (id) { return document.getElementById(id).value.trim(); };
        var err = document.getElementById('c-err');
        var pw = document.getElementById('c-pw').value;
        if (!v('c-name')) { err.textContent = 'Vui lòng nhập họ tên'; return; }
        if (!EMAIL_RE.test(v('c-email'))) { err.textContent = 'Email không hợp lệ'; return; }
        if (pw.length < 6) { err.textContent = 'Mật khẩu tối thiểu 6 ký tự'; return; }
        err.textContent = '';
        var btn = document.getElementById('c-submit');
        btn.disabled = true;
        SC.api('/api/users', { method: 'POST', body: { name: v('c-name'), email: v('c-email'), studentId: v('c-sid'), faculty: v('c-faculty'), className: v('c-class'), phone: v('c-phone'), password: pw } })
          .then(function (res) {
            SC.closeModal('modal-create');
            SC.toast('success', 'Đã thêm sinh viên ' + res.user.name);
            state.page = 1;
            load();
          })
          .catch(function (er) { err.textContent = er.message; })
          .finally(function () { btn.disabled = false; });
      });

      load();
    })();
  </script>
</body>
</html>
