# Cổng chạy server
PORT=3001
NODE_ENV=development

# Chuỗi kết nối MongoDB Atlas (thay <username>, <password>, <cluster-url>)
# QUAN TRỌNG: tên database (đoạn sau dấu / và trước dấu ?) phải TRÙNG với database mà app sinh viên đang ghi dữ liệu vào.
# Nếu app sinh viên không chỉ định tên database thì MongoDB mặc định dùng "test".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/test?retryWrites=true&w=majority

# Khóa bí mật ký JWT (đổi thành chuỗi ngẫu nhiên dài)
JWT_SECRET=doi_thanh_chuoi_bi_mat_that_dai_va_ngau_nhien
JWT_EXPIRES_IN=1d

# Tài khoản admin được tự tạo ở lần chạy đầu tiên nếu chưa có admin
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@smartcampus.edu.vn
ADMIN_PASSWORD=Admin@123
